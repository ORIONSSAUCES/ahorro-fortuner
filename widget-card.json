{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "🚙 Mi Ahorro · Fortuner",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${saved} de ${goal}",
      "isSubtle": true,
      "spacing": "Small",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${pct}% completado · falta ${rest}",
      "weight": "Bolder",
      "color": "Good",
      "spacing": "Small",
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Registrar depósito",
      "url": "./index.html?action=deposit"
    }
  ]
